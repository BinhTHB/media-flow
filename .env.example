OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
GITHUB_TOKEN=

# Subtitle OCR is local RapidOCR. Gemini is not used for OCR.
MEDIAFLOW_OCR_PROVIDER=rapidocr

# Visual OCR fallback + quality fallback translation / ASR fallback + Gemini 3.1 Flash Live TTS fallback.
GEMINI_API_KEY=
# Optional prebuilt voice for Gemini 3.1 Flash Live (for example Sulafat, Achird, Leda).
GEMINI_LIVE_TTS_VOICE=

# Audio ASR primary. MediaFlow prefers whisper-large-v3 when configured.
GROQ_API_KEY=

# Optional ElevenLabs Free API key pool. Put every account key in this ONE comma-separated variable.
# Used by both Eleven v3 TTS and Dubbing v2. Native Voice Library voices may require a paid tier.
ELEVENLABS_API_KEYS=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_LANGUAGE_CODE=vi
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
ELEVENLABS_STABILITY=0.42
ELEVENLABS_SIMILARITY_BOOST=0.80
ELEVENLABS_STYLE=0
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.0

# OpenRouter pool: keep every account key in this ONE comma-separated variable.
OPENROUTER_API_KEYS=
OPENROUTER_TRANSLATION_MODELS=inclusionai/ling-3.0-flash:free,google/gemma-4-26b-a4b-it:free,minimax/minimax-m2.7:free
# Optional separate model order for selective ASR disagreement resolution.
OPENROUTER_ASR_CORRECTION_MODELS=inclusionai/ling-3.0-flash:free,google/gemma-4-26b-a4b-it:free,minimax/minimax-m2.7:free
# Cool down a key after HTTP 429 before trying it again on later batches.
OPENROUTER_429_COOLDOWN_SECONDS=900
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=MediaFlow

# Fish S2.1 Pro Free is a fallback and uses the same OpenRouter pool.
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# Public Vietnamese Fish mappings for Edge-compatible UI voice ids.
OPENROUTER_FISH_FEMALE_VOICE=c5660c5f4f7b4b74be5f248a75d7fee6
OPENROUTER_FISH_MALE_VOICE=28902432d87243f08638ba59a1569781
# Explicit voice override: --voice fish:<reference_id> or --voice gemini-live:<voice_name>.